rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function hasPermission(perm) {
      return isAdmin() || (
        isMember() && 
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.permissions[perm] == true
      );
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isMember() || isAdmin() || (isAuthenticated() && request.auth.uid == memberId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMember() && request.auth.uid == memberId && 
        // Normal members cannot change their own role, status, or permissions
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions', 'uid', 'email']));
    }

    // Join requests collection
    match /joinRequests/{requestId} {
      // Public applicants can submit requests
      allow create: if request.resource.data.status == 'pending';
      // Only admin or authorized members can view, accept, or reject requests
      allow read: if hasPermission('reviewRequests') || hasPermission('manageRequests') || isAdmin();
      allow update: if (hasPermission('manageRequests') || isAdmin()) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'notes']);
      allow delete: if isAdmin();
    }

    // Todos collection
    match /todos/{todoId} {
      allow read: if isMember() && (resource.data.assignedTo == request.auth.uid || isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if isMember() && (request.resource.data.assignedTo == request.auth.uid || hasPermission('assignTodos') || isAdmin());
      allow update: if isMember() && (
        resource.data.assignedTo == request.auth.uid || 
        resource.data.createdBy == request.auth.uid || 
        hasPermission('assignTodos') || 
        isAdmin()
      );
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == request.auth.uid);
    }

    // Events collection
    match /events/{eventId} {
      // Events can be read by any active member or public
      allow read: if true;
      allow create: if hasPermission('createEvents') || isAdmin();
      allow update, delete: if hasPermission('createEvents') || isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isMember() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isMember() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isMember() && resource.data.recipientUid == request.auth.uid;
    }

    // Activity log collection
    match /activity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
